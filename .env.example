# Postgres connection string. On Vercel the Neon integration sets this for you.
DATABASE_URL=

# Signs the sign-in cookie. Use a long random string, for example:
#   openssl rand -base64 32
SESSION_SECRET=

# Who may sign in. Comma-separated email domains; defaults to verisave.com.
# Set to * to allow any address.
ALLOWED_EMAIL_DOMAINS=verisave.com

# Extra individual addresses allowed in addition to the domains above.
ALLOWED_EMAILS=
